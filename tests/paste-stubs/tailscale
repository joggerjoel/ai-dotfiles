#!/usr/bin/env bash
# Stub for `tailscale`. Serves whatever address behaviour a test needs:
#
#   PASTE_TS_IP     the address to report (default 127.0.0.1, so a test server
#                   binds somewhere harmless rather than a real tailnet address)
#   PASTE_TS_FAIL   set: exit non-zero, as on a machine without tailscale
#   PASTE_TS_MULTI  set: report two addresses, which must refuse to bind rather
#                   than pick one
printf '%s\n' "$*" >> "${PASTE_CALLS:-/dev/null}"

[ -n "${PASTE_TS_FAIL:-}" ] && { echo "tailscale not running" >&2; exit 1; }

if [ -n "${PASTE_TS_MULTI:-}" ]; then
  printf '100.64.0.1\n100.64.0.2\n'
  exit 0
fi

printf '%s\n' "${PASTE_TS_IP:-127.0.0.1}"
