#!/usr/bin/env bash
# Stub for `ssh`. Serves recorded probe output from $HERDR_AUTH_FIXTURE.
# Invoked as: ssh [opts] <host> <command...>
# Picks the fixture by host plus which CLI the command mentions.
host=""
skip=0
while [ $# -gt 0 ]; do
  if [ "$skip" = 1 ]; then skip=0; shift; continue; fi
  case "$1" in
    -o) skip=1; shift ;;
    -*) shift ;;
    *) host="$1"; shift; break ;;
  esac
done
cmd="$*"

# host_reachable() probes with the bare command `true`. If a fixture named
# <host>.unreachable exists, model an ssh connect failure by exiting 255 —
# ssh's own code for "couldn't reach the host" — instead of succeeding.
if [ "$cmd" = true ] && [ -f "$HERDR_AUTH_FIXTURE/$host.unreachable" ]; then
  exit 255
fi

# Model `cursor-agent login`'s process LIFETIME, not just its output. The real
# CLI prints its URL and then keeps running, polling until the human completes
# the flow. A stub that prints and exits models a command that returns — the
# assumption that let a deadlock ship under a green suite.
#
#   detached form (nohup … >LOG &) → deliver the fixture into LOG, return now
#   reading form  (cat LOG)        → serve whatever LOG holds
#   foreground form                → print, then BLOCK, like the real one
LOG="${HERDR_AUTH_CURSOR_LOG:-/tmp/herdr-auth-cursor-login.log}"
CODEXLOG="${HERDR_AUTH_CODEX_LOG:-/tmp/herdr-auth-codex-login.log}"

# An ordered journal of the calls that matter, so a test can assert SEQUENCE
# rather than just occurrence. Serialisation is a property of ordering and is
# invisible to any assertion that only checks a call happened.
order() { printf '%s %s\n' "$1" "$host" >> "${HERDR_AUTH_ORDER:-/dev/null}"; }

case "$cmd" in
  *nohup*"cursor-agent login"*)
    f="$HERDR_AUTH_FIXTURE/$host.cursorlogin"
    [ -f "$f" ] || { echo "no fixture: $f" >&2; exit 1; }
    cat "$f" > "$LOG"
    order start
    exit 0
    ;;
  # Answers plain `codex login` as readily as `--device-auth`, on purpose. Plain
  # `codex login` calls back to localhost on the remote and dies silently when
  # the browser is on another machine — but a stub that refused it would make a
  # regressed script fail for want of a fixture, blaming the harness instead of
  # naming the defect. Serve either, record which was actually run, and let the
  # assertion be about the command.
  *nohup*"codex login"*)
    f="$HERDR_AUTH_FIXTURE/$host.codexlogin"
    [ -f "$f" ] || { echo "no fixture: $f" >&2; exit 1; }
    cat "$f" > "$CODEXLOG"
    printf '%s\n' "$cmd" >> "${HERDR_AUTH_START_CMD:-/dev/null}"
    # Marks that a flow began, so the probe can answer differently afterwards.
    # Without this the fixtures are static and no test can express "the human
    # entered the code and the login completed" — which left the entire success
    # path uncovered, and a credential-bearing log leaking on it.
    : > "$HERDR_AUTH_FIXTURE/$host.started"
    order start
    exit 0
    ;;
  *cat*herdr-auth-codex-login*|*cat*"$CODEXLOG"*)
    [ -f "$CODEXLOG" ] && cat "$CODEXLOG"
    exit 0
    ;;
  *cat*herdr-auth-cursor-login*|*cat*"$LOG"*)
    [ -f "$LOG" ] && cat "$LOG"
    exit 0
    ;;
  # Match on `pkill` alone, never on the pattern the script happens to send. A
  # stub that encodes the expected pattern agrees with the script by
  # construction and so cannot catch a bad pattern — which is how a
  # self-matching one survived a green suite. Record the command verbatim so a
  # test can assert properties of the pattern itself.
  *pkill*)
    printf '%s\n' "$host" >> "${HERDR_AUTH_CANCELLED:-/dev/null}"
    printf '%s\n' "$cmd" >> "${HERDR_AUTH_PKILL_CMD:-/dev/null}"
    order cancel
    rm -f "$LOG" "$CODEXLOG"
    exit 0
    ;;
  # A bare `rm -f` of the codex log — the cleanup a SUCCESSFUL login performs,
  # modelled separately because the leak was that ONLY cancel cleaned up: on the
  # happy path a real fleet run left a world-readable file holding the device
  # code on five hosts.
  #
  # Ordered AFTER *pkill* deliberately. The cancel command is
  # `rm -f LOG; pkill ...` and contains both, so a first-wins case with this
  # branch above would swallow every cancellation — which it did, breaking the
  # serialisation and codeless-host tests the moment it was added.
  *"rm -f"*herdr-auth-codex-login*|*"rm -f"*"$CODEXLOG"*)
    rm -f "$CODEXLOG"
    exit 0
    ;;
esac

case "$cmd" in
  *"cursor-agent login"*) probe=cursorlogin ;;
  *cursor-agent*) probe=cursor ;;
  *"codex login status"*) probe=codex ;;
  *credentials.json*) probe=claude ;;
  *) exit 0 ;;
esac

f="$HERDR_AUTH_FIXTURE/$host.$probe"

# Once a codex flow has started, serve <host>.codex2 when it exists — the state
# the CLI reaches after the human enters the device code. Keeps $probe as codex
# so the stderr modelling below still applies.
if [ "$probe" = codex ] \
   && [ -f "$HERDR_AUTH_FIXTURE/$host.started" ] \
   && [ -f "$HERDR_AUTH_FIXTURE/$host.codex2" ]; then
  f="$HERDR_AUTH_FIXTURE/$host.codex2"
fi

[ -f "$f" ] || { echo "no fixture: $f" >&2; exit 1; }

# The foreground form is the bug under guard: serve the fixture, then hang.
# A caller that waits for exit now stalls and fails on elapsed time instead of
# passing quietly.
if [ "$probe" = cursorlogin ]; then
  cat "$f"
  sleep "${HERDR_AUTH_STUB_BLOCK:-5}"
  exit 0
fi

# Model the real CLIs' stream behaviour. `codex login status` writes to STDERR
# (verified: 0 bytes on stdout), so a caller that does not merge the streams
# inside the remote command sees nothing. Serving the codex fixture on stderr
# unless the command contains 2>&1 is what makes the probe tests a real
# regression guard rather than a tautology.
if [ "$probe" = codex ] && [ "${cmd#*2>&1}" = "$cmd" ]; then
  cat "$f" >&2
else
  cat "$f"
fi
exit 0
