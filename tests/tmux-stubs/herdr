#!/usr/bin/env bash
# Stub herdr for herdr-tmux tests. Logs every invocation to $HERDR_TMUX_CALLS
# and answers list queries from $HERDR_TMUX_WS (one "<id>|<label>" per line)
# and $HERDR_TMUX_TABS (one "<tab_id>|<ws_id>|<label>" per line).

printf '%s\n' "$*" >> "${HERDR_TMUX_CALLS:-/dev/null}"

json_workspaces() {
  printf '{"result":{"workspaces":['
  local first=1
  while IFS='|' read -r id label; do
    [ -n "$id" ] || continue
    [ "$first" = 1 ] || printf ','
    first=0
    printf '{"workspace_id":"%s","label":"%s"}' "$id" "$label"
  done < "${HERDR_TMUX_WS:-/dev/null}"
  printf ']}}'
}

json_tabs() {
  printf '{"result":{"tabs":['
  local first=1
  while IFS='|' read -r id ws label; do
    [ -n "$id" ] || continue
    [ "$first" = 1 ] || printf ','
    first=0
    printf '{"tab_id":"%s","workspace_id":"%s","label":"%s"}' "$id" "$ws" "$label"
  done < "${HERDR_TMUX_TABS:-/dev/null}"
  printf ']}}'
}

case "$1 $2" in
  "workspace list") json_workspaces ;;
  "tab list")       json_tabs ;;
  "workspace create")
    # Append the new workspace so a later list sees it.
    id="w$(( $(wc -l < "${HERDR_TMUX_WS:-/dev/null}") + 90 ))"
    label=""
    while [ $# -gt 0 ]; do
      [ "$1" = --label ] && label="$2"
      shift
    done
    printf '%s|%s\n' "$id" "$label" >> "$HERDR_TMUX_WS"
    printf '{"result":{"workspace":{"workspace_id":"%s","label":"%s"}}}' "$id" "$label"
    ;;
  "tab create"|"tab rename") printf '{"result":{}}' ;;
  *) printf '{"result":{}}' ;;
esac
