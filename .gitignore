# Secrets - never commit
.env
*.env.local
.env.*
!.env.example

# Real fleet inventory (IPs, jump hosts, usernames) — copy from inventory.example.yml.
# Glob also covers the .bak/.tmp files ssh-ansible-sync.sh writes beside it.
ansible-ai/inventory.local.yml*

# Live/personal config that can accumulate inline secrets (CC permission allowlist, etc.)
/settings.json
# MCP profiles hold live tokens (e.g. SUPABASE_ACCESS_TOKEN) — keep the README, ignore the JSON
profiles/mcp/*.json

# Machine-specific overrides (personal config)
.local/

# Local tool state (generated per-machine, not versioned)
.serena/

# OS files
.DS_Store
Thumbs.db

# Backups
backups/
backup/

# Python bytecode from importing hooks (injection-guard backtest)
__pycache__/

# git worktrees created by EnterWorktree (scratch, never committed)
.claude/worktrees/

# subagent-driven-development scratch ledger
.superpowers/

# docs accumulate personal/project context over time - keep the whole tree untracked
docs/

# per-host injection-guard baseline (never shared — see 6e37940)
hooks/injection-guard.baseline.json

# Vendored third-party executable payload (Leonxlnx/unlazy). The prose half of
# the skill is tracked; the Node checker that runs shell from CHECK: lines is
# not. skills/unlazy/.upstream pins the commit it came from, and setup.sh
# refetches it via scripts/vendor-unlazy-skill.sh when it is absent.
skills/unlazy/scripts/
