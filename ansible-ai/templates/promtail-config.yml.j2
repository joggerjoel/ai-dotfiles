{{ ansible_managed | comment }}
# Rendered from ansible-ai/templates/promtail-config.yml.j2.
#
# Ships this host's system logs and docker container logs into loki. The config
# this replaces shipped only /var/log from one host; container logs are the
# addition, since a box running 20-odd containers keeps most of its interesting
# output there.
#
# Promtail is end of life upstream. Replacing it with Grafana Alloy, and
# shipping from more than one host, is deferred and tracked in the design doc.
server:
  http_listen_port: 9080
  grpc_listen_port: 0
  log_level: warn

positions:
  # On the promtail volume, not in the container filesystem. Otherwise every
  # restart re-ships every log from the beginning.
  filename: /promtail/positions.yaml

clients:
  - url: http://loki:3100/loki/api/v1/push

scrape_configs:
  - job_name: varlogs
    static_configs:
      - targets: [localhost]
        labels:
          job: varlogs
          host: {{ inventory_hostname }}
          __path__: /var/log/**/*.log

  # Container stdout/stderr. The label comes from the container name rather
  # than the log filename, which is a 64-character hex id and useless in a
  # dashboard.
  - job_name: containers
    static_configs:
      - targets: [localhost]
        labels:
          job: containers
          host: {{ inventory_hostname }}
          __path__: /var/lib/docker/containers/*/*-json.log
    pipeline_stages:
      - json:
          expressions:
            output: log
            stream: stream
            time: time
      - timestamp:
          source: time
          format: RFC3339Nano
      - labels:
          stream:
      - output:
          source: output
