#!/usr/bin/env bash
# herdr-new-project — pick a project, pick a CLI, open it in a new herdr tab.
#
# Bound to a `[[keys.command]]` popup in ~/.config/herdr/config.toml. herdr's
# built-in `new_tab` (prefix+c) is left alone, so there is always a
# dependency-free way to get a plain shell.
#
#   <key>  ->  fzf: which repo under ~/Developer?
#          ->  fzf: which CLI?
#          ->  new tab, cwd = repo, running that CLI
#
# Two-step launch, because herdr's tab.create API accepts only
# cwd/env/label/focus — there is no "command" field, so a new tab always spawns
# a plain login shell. Execution is a separate call against the live pane. This
# is the same constraint herdr-wire-space.sh works around.
#
# Env overrides:
#   HERDR_PROJECT_ROOTS   colon-separated roots to scan   (default: ~/Developer)
#   HERDR_PROJECT_DEPTH   how deep to look for .git       (default: 3)

set -euo pipefail

# The herdr server inherits PATH from whatever env started it, which is usually
# complete — but a server started by launchd is not. Prepend the dirs this
# script's dependencies live in.
PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

DEPTH="${HERDR_PROJECT_DEPTH:-3}"

# TODO(joel): order = frequency; fzf pre-selects the top entry, so put the CLI
# you reach for most first. Format is "label|command". Entries whose command is
# not on PATH are dropped automatically, so it is safe to list optimistically.
# `agent` is omitted on purpose — it is a symlink to cursor-agent.
CLI_MENU=(
  "claude|claude"
  "codex|codex"
  "cursor-agent|cursor-agent"
  "opencode|opencode"
  "gemini|gemini"
  "pi|pi"
  "shell|"
)

die() {
  printf '\n  %s\n\n' "$*" >&2
  printf '  press any key to close ' >&2
  read -r -n 1 -s || true
  exit 1
}

command -v herdr >/dev/null 2>&1 || die "herdr not found on PATH."
command -v fzf >/dev/null 2>&1 || die "fzf not found. install it with:  brew install fzf"

# --- discover projects ------------------------------------------------------
# -name .git (not -type d) so linked worktrees, where .git is a file, are found.
# -prune stops find from descending into the .git dir it just matched.
IFS=':' read -r -a roots <<<"${HERDR_PROJECT_ROOTS:-$HOME/Developer}"

existing_roots=()
for root in "${roots[@]}"; do
  [ -d "$root" ] && existing_roots+=("$root")
done
[ ${#existing_roots[@]} -gt 0 ] || die "none of these roots exist: ${roots[*]}"

projects=()
while IFS= read -r line; do
  [ -n "$line" ] && projects+=("$line")
done < <(
  find -L "${existing_roots[@]}" -maxdepth "$DEPTH" -name .git -prune -print 2>/dev/null |
    sed 's|/\.git$||' |
    sort -u
)

[ ${#projects[@]} -gt 0 ] || die "no git repos found under: ${existing_roots[*]}"

# --- pick a project ---------------------------------------------------------
# Display paths as ~/foo rather than /Users/joggerjoel/foo, then expand back.
dir=$(
  printf '%s\n' "${projects[@]}" |
    sed "s|^$HOME|~|" |
    fzf --prompt='project> ' --height=100% --layout=reverse --border=none \
        --info=inline --no-multi
) || exit 0
[ -n "$dir" ] || exit 0
dir="${dir/#\~/$HOME}"

# --- pick a CLI -------------------------------------------------------------
name=$(basename "$dir")

menu=()
for entry in "${CLI_MENU[@]}"; do
  cmd="${entry#*|}"
  # An empty command means "just a shell" — always available.
  if [ -z "$cmd" ] || command -v "${cmd%% *}" >/dev/null 2>&1; then
    menu+=("$entry")
  fi
done
[ ${#menu[@]} -gt 0 ] || die "no CLIs from CLI_MENU are on PATH."

# Shows only the label; fzf still returns the full label|command line. The
# template form '{1}' is required over a bare `1` — the latter renders the
# field with its trailing delimiter, i.e. "claude|" instead of "claude".
picked=$(
  printf '%s\n' "${menu[@]}" |
    fzf --prompt="cli for $name> " --height=100% --layout=reverse --border=none \
        --info=inline --no-multi --delimiter='|' --with-nth='{1}'
) || exit 0
[ -n "$picked" ] || exit 0
cmd="${picked#*|}"

# --- create the tab ---------------------------------------------------------
created=$(herdr tab create --cwd "$dir" --label "$name" --focus 2>&1) || true
case "$created" in
  *'"type":"tab_created"'*) ;;
  *) die "herdr tab create failed: $created" ;;
esac

# tab.create returns the new tab's root_pane inline, so no second lookup.
pane=$(printf '%s' "$created" | sed -n 's/.*"pane_id":"\([^"]*\)".*/\1/p')
[ -n "$pane" ] || die "could not read pane_id from: $created"

# --- run the CLI in it ------------------------------------------------------
# `exec $SHELL -l` matters: without it the pane would sit at a dead prompt once
# the CLI exits. Chaining a login shell leaves you in the project dir instead.
# This mirrors herdr-wire-space.sh's `fallback` policy.
[ -n "$cmd" ] || exit 0
herdr pane run "$pane" "$cmd; exec ${SHELL:-/bin/zsh} -l" >/dev/null 2>&1 ||
  die "herdr pane run failed for pane $pane"
